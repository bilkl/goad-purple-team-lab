<group name="goad_purple,windows,">
  <rule id="100100" level="5">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4625$</field>
    <description>GOAD: échec d'authentification Windows</description>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100101" level="6">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.logonType">^3$</field>
    <description>GOAD: ouverture de session réseau (à corréler au test)</description>
    <mitre><id>T1078</id></mitre>
  </rule>
  <rule id="100102" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4662$</field>
    <field name="win.eventdata.properties" type="pcre2">(?i)(1131f6aa|1131f6ad|89e95b76)</field>
    <description>GOAD: utilisation des droits de réplication AD (vérifier l'identité source)</description>
    <mitre><id>T1003.006</id></mitre>
  </rule>
</group>
